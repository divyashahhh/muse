# Copy to .env and fill in. Never commit .env.

# Async SQLAlchemy URL. Local Postgres.app / docker-compose both work.
DATABASE_URL=postgresql+asyncpg://localhost:5432/muse

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Reserved for upcoming phases (aesthetic reasoning, CLIP inference, object storage).
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

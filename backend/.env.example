# Copy to .env and fill in. Never commit .env.

# Async SQLAlchemy URL. Hosted postgres:// URLs are converted automatically.
DATABASE_URL=postgresql+asyncpg://localhost:5432/muse

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Claude — image analysis and same-product verification. https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# SerpApi — Google Lens + Google Shopping results from real retailers. https://serpapi.com
SERPAPI_API_KEY=
# Market to search in (two-letter country / language codes).
SEARCH_COUNTRY=us
SEARCH_LANGUAGE=en

# Supabase Storage — public URLs for uploaded images (Google Lens needs a public image URL).
# Without these, uploads are stored locally and visual search runs only for product URLs.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Where the API is reachable; used to build URLs for locally stored uploads.
PUBLIC_API_URL=http://localhost:8000

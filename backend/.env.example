# Copy to .env and fill in. Never commit .env.

# Async SQLAlchemy URL. Hosted postgres:// URLs are converted automatically.
DATABASE_URL=postgresql+asyncpg://localhost:5432/muse

# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# AI provider for item analysis and same-product verification: gemini (free tier) or claude.
AI_PROVIDER=gemini

# Google Gemini — free API key, no card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated; tried in order when the primary model is overloaded or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Anthropic Claude (paid) — used when AI_PROVIDER=claude. https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Free product search sources (enable one or both) ---
# Tavily web search: 1,000 free credits/month, no card. https://app.tavily.com
TAVILY_API_KEY=
# eBay Browse API: free developer account, 5,000 calls/day. https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Supabase Storage for uploaded images, for deployments without a persistent disk.
# Without these, uploads are stored on local disk (fine for development).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Where the API is reachable; used to build URLs for locally stored uploads.
PUBLIC_API_URL=http://localhost:8000

# Where the web app is served; visiting the API root redirects there (to /docs when empty).
FRONTEND_URL=
